// Full (bidirectional) flash attention — phase-split, high-occupancy variant.
//
// This replaces the previous "one thread per (row,col) with a full-head output
// accumulator" design. That design was measured to be latency/occupancy bound:
// each thread held a 128-float output accumulator (my_O[32]) even though it
// only produced a single score per tile, pinning the kernel to 1-2 workgroups
// per SM. Shrinking the accumulator (f32 -> f16) alone gave 1.45x, confirming
// occupancy is the limiter, not DRAM bandwidth.
//
// New structure (same online-softmax math, different dataflow):
//   Phase 1 (QK): thread (row,col) computes S[row,col] over the full head_dim.
//   Phase 2:      online softmax -> weight w written to shared Pf.
//   Phase 3 (PV): thread (row,dim) owns ONE output vec4 and accumulates
//                 O[row,dim] += sum_c Pf[row,c] * V[c,dim].
//
// The per-thread output accumulator is now a single vec4 (vs 32), so register
// pressure collapses and many more workgroups fit per SM. Q/K/V live in shared
// memory as f16; the softmax is f32.
//
// Q/K/V layout: [seq_len, num_heads * head_dim] (f32, row-major)
// Output:       [seq_len, num_heads * head_dim] (f32, row-major)
//
// Dispatch: groups_x = num_heads, groups_y = ceil(seq_len / BR)
// Push constants: num_heads, num_kv_heads, head_dim, kv_dim, seq_len, scale
// Buffers: 0=out (vec4), 1=Q (vec4), 2=K (vec4), 3=V (vec4)

#version 450
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 512) in;

layout(set = 0, binding = 0) buffer AttnOut   { vec4 out_v4[]; };
layout(set = 0, binding = 1) readonly buffer Q { vec4 q_v4[];   };
layout(set = 0, binding = 2) readonly buffer K { vec4 k_v4[];   };
layout(set = 0, binding = 3) readonly buffer V { vec4 v_v4[];   };

layout(push_constant) uniform Params {
    int num_heads;
    int num_kv_heads;
    int head_dim;
    int kv_dim;
    int seq_len;
    float scale;
};

#define WG_SIZE  512
#define BR       16      // query rows per WG (16 rows x 32 threads = 512)
#define BC       32      // K/V positions per tile
#define HD4      32      // head_dim / 4 = 128 / 4
#define HD4P     33      // HD4 + 1 shared-memory padding

// Shared memory (f16vec4 unless noted):
//   Qf:  BR x HD4P = 8 x 33   = 264   = 2.1 KB
//   ksh: BC x HD4P = 32 x 33  = 1056  = 8.4 KB
//   vsh: BC x HD4P = 32 x 33  = 1056  = 8.4 KB
//   Pf:  BR x BC   = 8 x 32   floats  = 1.0 KB
// Total: ~19.9 KB  -> ~5 workgroups/SM (vs 1-2 before)
shared f16vec4 Qf[BR * HD4P];
shared f16vec4 ksh[BC * HD4P];
shared f16vec4 vsh[BC * HD4P];
shared float   Pf[BR * BC];

void main() {
    uint head = gl_WorkGroupID.x;
    uint wg_row = gl_WorkGroupID.y;
    if (head >= uint(num_heads)) return;

    uint tid = gl_LocalInvocationID.x;
    uint kv_mul = uint(num_heads) / uint(num_kv_heads);
    uint kv_head = head / kv_mul;
    uint kvd4 = uint(kv_dim) >> 2u;
    uint qd4 = uint(num_heads) * uint(HD4);
    uint kv_off4 = kv_head * uint(HD4);
    int N = seq_len;
    uint qi_base = wg_row * uint(BR);
    uint br_valid = min(uint(BR), uint(N) - qi_base);

    uint my_row = tid >> 5u;     // 0..7
    uint my_col = tid & 31u;     // 0..31 (column index in phase 1, dim index in phase 3)

    // --- Load BR query vectors into Qf (f32 global -> f16 shared, pre-scaled) ---
    for (uint i = tid; i < uint(BR) * uint(HD4); i += WG_SIZE) {
        uint r = i / uint(HD4);
        uint d = i % uint(HD4);
        uint qi = qi_base + r;
        vec4 qv = (qi < uint(N))
            ? q_v4[qi * qd4 + head * uint(HD4) + d] * scale
            : vec4(0.0);
        Qf[r * HD4P + d] = f16vec4(qv);
    }

    // Output accumulator: this thread owns output dims [4*my_col, 4*my_col+4) of
    // row my_row. One vec4 — the whole point of the redesign.
    vec4 my_O = vec4(0.0);

    float running_max = -1e30;
    float running_sum = 0.0;

    barrier();

    // =====================================================================
    // Main tile loop
    // =====================================================================
    for (int tile_start = 0; tile_start < N; tile_start += int(BC)) {
        int tile_len = min(int(BC), N - tile_start);

        // --- Load K and V tiles into shared (f32 global -> f16 shared) ---
        for (uint i = tid; i < uint(BC) * uint(HD4); i += WG_SIZE) {
            uint p = i / uint(HD4);
            uint d = i % uint(HD4);
            int pos = tile_start + int(p);
            bool ok = pos < N;
            uint src = uint(pos) * kvd4 + kv_off4 + d;
            ksh[p * HD4P + d] = ok ? f16vec4(k_v4[src]) : f16vec4(0.0);
            vsh[p * HD4P + d] = ok ? f16vec4(v_v4[src]) : f16vec4(0.0);
        }
        barrier(); // K/V ready

        // --- Phase 1: QK^T for this thread's column (full head_dim dot) ---
        float s = -1e30;
        if (my_row < br_valid && int(my_col) < tile_len) {
            float dv = 0.0;
            [[unroll]] for (uint d = 0u; d < uint(HD4); d++) {
                f16vec4 qv = Qf[my_row * HD4P + d];
                f16vec4 kv = ksh[my_col * HD4P + d];
                dv += float(qv.x * kv.x + qv.y * kv.y + qv.z * kv.z + qv.w * kv.w);
            }
            s = dv;
        }

        // --- Phase 2: online softmax (row = one subgroup, no barriers) ---
        float m = s;
        [[unroll]] for (uint off = 16u; off >= 1u; off >>= 1u)
            m = max(m, subgroupShuffleXor(m, off));

        float new_max = max(running_max, m);
        float corr = exp(running_max - new_max);
        running_max = new_max;
        running_sum *= corr;
        my_O *= corr;

        float w = (my_row < br_valid && int(my_col) < tile_len)
            ? exp(s - new_max) : 0.0;
        float wsum = w;
        [[unroll]] for (uint off = 16u; off >= 1u; off >>= 1u)
            wsum += subgroupShuffleXor(wsum, off);
        running_sum += wsum;

        // Publish weights. Columns past tile_len hold w=0 (see guard above), so
        // phase 3 can loop over the whole BC unconditionally.
        if (my_row < br_valid)
            Pf[my_row * BC + my_col] = w;
        barrier(); // Pf ready for all rows

        // --- Phase 3: PV. Thread (my_row, my_col) owns output dim vec4 my_col ---
        {
            vec4 acc = my_O;
            [[unroll]] for (uint c = 0u; c < uint(BC); c++) {
                float p = Pf[my_row * BC + c];
                acc += p * vec4(vsh[c * HD4P + my_col]);
            }
            my_O = acc;
        }
        barrier(); // PV done; safe to overwrite ksh/vsh/Pf next tile
    }

    // --- Write output: thread owns dim vec4 my_col of row my_row ---
    uint qi = qi_base + my_row;
    float inv_sum = (running_sum > 0.0) ? (1.0 / running_sum) : 0.0;
    if (my_row < br_valid) {
        out_v4[qi * qd4 + head * uint(HD4) + my_col] = my_O * inv_sum;
    }
}
