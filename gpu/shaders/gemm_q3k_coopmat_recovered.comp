#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q3_K-weight × FP32-input GEMM using cooperative matrix (tensor cores).
// Tile: BM=64, BN=64, BK=32.  128 threads = 4 subgroups in 2×2 layout.
// Each subgroup: 2×2 coopmat 16×16 tiles → 32×32 output.
// BK=32 covers two Q3_K scale groups; source dequantization matches the CPU reference.

#define BM     64u
#define BN     64u
#define BK     32u
#define SHMEM_STRIDE (BK / 2u + 4u)  // = 20 f16vec2 per row
#define TM     16u
#define TN     16u
#define TK     16u
#define SG_M   2u
#define SG_N   2u
#define CMS_M  2u
#define CMS_N  2u
#define N_K_TILES (BK / TK)  // = 2

layout(local_size_x = 128) in;

// Q3_K block: 256 elements, 110 bytes
struct block_q3_k {
    uint8_t hmask[32];
    uint8_t qs[64];
    uint8_t scales[12];
    float16_t d;
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q3_k data_a[]; };
layout(set = 0, binding = 2) readonly buffer B { float data_b[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int npos;
};

shared f16vec2 smA[BM * SHMEM_STRIDE];
shared f16vec2 smB[BN * SHMEM_STRIDE];
shared float out_stage[BM * BN];

void extract_scales(uint ib, out int sc[16]) {
    uint a0 = uint(data_a[ib].scales[0]) | (uint(data_a[ib].scales[1]) << 8) |
        (uint(data_a[ib].scales[2]) << 16) | (uint(data_a[ib].scales[3]) << 24);
    uint a1 = uint(data_a[ib].scales[4]) | (uint(data_a[ib].scales[5]) << 8) |
        (uint(data_a[ib].scales[6]) << 16) | (uint(data_a[ib].scales[7]) << 24);
    uint a2 = uint(data_a[ib].scales[8]) | (uint(data_a[ib].scales[9]) << 8) |
        (uint(data_a[ib].scales[10]) << 16) | (uint(data_a[ib].scales[11]) << 24);

    const uint kmask1 = 0x03030303u;
    const uint kmask2 = 0x0f0f0f0fu;

    uint tmp = a2;
    uint o0 = (a0 & kmask2) | (((tmp >> 0) & kmask1) << 4);
    uint o1 = (a1 & kmask2) | (((tmp >> 2) & kmask1) << 4);
    uint o2 = ((a0 >> 4) & kmask2) | (((tmp >> 4) & kmask1) << 4);
    uint o3 = ((a1 >> 4) & kmask2) | (((tmp >> 6) & kmask1) << 4);

    uint words[4] = uint[4](o0, o1, o2, o3);
    for (int i = 0; i < 16; i++) {
        sc[i] = int((words[i / 4] >> uint((i % 4) * 8)) & 0xFFu);
    }
}

// Dequantize element `local_k` (0..255) of Q3_K row `gn` at K offset `gk`.
float dequant_q3k(uint gn, uint gk, uint cols) {
    uint num_sb = cols >> 8;             // 256-element super-blocks per row
    uint block_k = gk >> 8;
    uint local_k = gk & 255u;
    uint ib = gn * num_sb + block_k;     // block index into data_b

    float d_all = float(data_a[ib].d);

    int sc[16];
    extract_scales(ib, sc);
    // 16 scale groups of 16 elements: is = local_k / 16.
    float dl = d_all * float(sc[local_k >> 4] - 32);

    // qs byte = (local_k / 128) * 32 + (local_k % 32); 2-bit field = (local_k/32)%4.
    uint q_idx = (local_k >> 7) * 32u + (local_k & 31u);
    int v = int((uint(data_a[ib].qs[q_idx]) >> uint(((local_k >> 5) & 3u) * 2u)) & 0x03u);
    // hmask byte = local_k % 32; bit = local_k / 32 (0..7).
    uint hbyte = uint(data_a[ib].hmask[local_k & 31u]);
    if ((hbyte & (1u << (local_k >> 5))) == 0u) {
        v -= 4;
    }
    return dl * float(v);
}


void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sg_id = gl_SubgroupID;
    uint sg_m = sg_id / SG_N;
    uint sg_n = sg_id % SG_N;

    uint n_tiles_n = (uint(npos) + BN - 1u) / BN;
    uint tile_n = gl_WorkGroupID.x % n_tiles_n;
    uint tile_m = gl_WorkGroupID.x / n_tiles_n;

    uint wg_m = tile_m * BM;
    uint wg_n = tile_n * BN;
    uint M = uint(rows);
    uint K = uint(cols);
    uint N = uint(npos);
    uint num_blocks_per_row = K / 256u;

    coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[CMS_M * CMS_N];
    for (uint i = 0u; i < CMS_M * CMS_N; i++)
        acc[i] = coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);

    // A loads: BM * BK/2 = 64*16 = 1024 f16vec2 / 128 threads = 8 per thread
    // B loads: same
    const uint LOAD_COUNT = (BM * (BK / 2u)) / 128u;  // 8

    for (uint k_base = 0u; k_base < K; k_base += BK) {
        // === Load A tile: dequantize Q3_K weights into smA ===
        // Each thread dequantizes 8 f16vec2 = 16 scalar values.
        // BK=32 = one scale group within a Q3_K super-block.
        for (uint e = 0u; e < LOAD_COUNT; e++) {
            uint idx = e * 128u + tid;
            uint row = idx / (BK / 2u);     // 0..63 row within BM
            uint col2 = idx % (BK / 2u);    // 0..15 vec2 index within BK
            uint m_global = wg_m + row;
            uint k_global = k_base + col2 * 2u;

            f16vec2 val = f16vec2(0.0, 0.0);
            if (m_global < M && k_global < K) {
                val.x = float16_t(dequant_q3k(m_global, k_global, K));
                val.y = (k_global + 1u < K) ? float16_t(dequant_q3k(m_global, k_global + 1u, K)) : float16_t(0.0);

            }
            smA[row * SHMEM_STRIDE + col2] = val;
        }

        // === Load B tile: FP32 input → smB (same as BF16 GEMM) ===
        for (uint e = 0u; e < LOAD_COUNT; e++) {
            uint idx = e * 128u + tid;
            uint row = idx / (BK / 2u);
            uint col2 = idx % (BK / 2u);
            uint n_global = wg_n + row;
            uint k_global = k_base + col2 * 2u;
            f16vec2 val = f16vec2(0.0, 0.0);
            if (n_global < N && k_global + 1u < K) {
                val.x = float16_t(data_b[n_global * K + k_global]);
                val.y = float16_t(data_b[n_global * K + k_global + 1u]);
            } else if (n_global < N && k_global < K) {
                val.x = float16_t(data_b[n_global * K + k_global]);
            }
            smB[row * SHMEM_STRIDE + col2] = val;
        }

        barrier();

        // === Compute with cooperative matrix ===
        for (uint kt = 0u; kt < N_K_TILES; kt++) {
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matA[CMS_M];
            for (uint am = 0u; am < CMS_M; am++) {
                uint sm_row = sg_m * CMS_M * TM + am * TM;
                coopMatLoad(matA[am], smA, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }

            for (uint an = 0u; an < CMS_N; an++) {
                coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matB;
                uint sm_row = sg_n * CMS_N * TN + an * TN;
                coopMatLoad(matB, smB, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

                for (uint am = 0u; am < CMS_M; am++) {
                    acc[am * CMS_N + an] = coopMatMulAdd(matA[am], matB, acc[am * CMS_N + an]);
                }
            }
        }

        barrier();
    }

    // Stage through shared memory to allow per-element bounds checking.
    // coopMatStore always writes a full 16×16 tile; without this, edge tiles
    // where base_n+16 > N would write past the output buffer causing TDR.
    for (uint am = 0u; am < CMS_M; am++) {
        for (uint an = 0u; an < CMS_N; an++) {
            uint sm_m = sg_m * CMS_M * TM + am * TM;
            uint sm_n = sg_n * CMS_N * TN + an * TN;
            coopMatStore(acc[am * CMS_N + an], out_stage, sm_n * BM + sm_m, BM,
                         gl_CooperativeMatrixLayoutColumnMajor);
        }
    }

    barrier();

    for (uint e = 0u; e < 32u; e++) {
        uint idx = e * 128u + tid;
        uint local_m = idx % BM;
        uint local_n = idx / BM;
        uint gm = wg_m + local_m;
        uint gn = wg_n + local_n;
        if (gm < M && gn < N) {
            out_data[gn * M + gm] = out_stage[local_n * BM + local_m];
        }
    }
}
