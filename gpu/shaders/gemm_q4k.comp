#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q4_K-weight × FP32-input GEMM using cooperative matrix (tensor cores).
// Tile: BM=64, BN=64, BK=32.  128 threads = 4 subgroups in 2×2 layout.
// Each subgroup: 2×2 coopmat 16×16 tiles → 32×32 output.
// BK=32 aligns perfectly with one Q4_K scale group.

#define BM     64u
#define BN     64u
#define BK     32u
#define SHMEM_STRIDE (BK / 2u + 4u)  // = 20 f16vec2 per row
#define TM     16u
#define TN     16u
#define TK     16u
#define SG_M   2u
#define SG_N   2u
#define CMS_M  2u
#define CMS_N  2u
#define N_K_TILES (BK / TK)  // = 2

layout(local_size_x = 128) in;

// Q4_K block: 256 elements, 142 bytes
struct block_q4_k {
    float16_t d;
    float16_t dmin;
    uint8_t scales[12];
    uint8_t qs[128];
};

struct block_q4_k_p32 {
    float16_t d;
    float16_t dmin;
    uint8_t scales[12];
    uint32_t qs[32];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q4_k data_a[]; };
layout(scalar, set = 0, binding = 1) readonly buffer AP32 { block_q4_k_p32 data_a_p32[]; };
layout(set = 0, binding = 2) readonly buffer B { float data_b[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int npos;
};

shared f16vec2 smA[BM * SHMEM_STRIDE];
shared f16vec2 smB[BN * SHMEM_STRIDE];

// Extract 6-bit scale for group `is` (0..7) from the packed scales[12] array.
// This matches llama.cpp's Q4_K scale extraction exactly.
float extract_scale(uint ib, uint is) {
    uint scidx0 = (is < 4u) ? is : (is + 4u);
    uint scidx1 = (is < 4u) ? is : (is - 4u);
    uint scidxmask1 = (is < 4u) ? 0x30u : 0xC0u;
    uint scidxshift1 = (is < 4u) ? 0u : 2u;
    return float(uint8_t(
        (data_a[ib].scales[scidx0] & 0xFu) |
        ((data_a[ib].scales[scidx1] & uint8_t(scidxmask1)) >> scidxshift1)
    ));
}

// Extract 6-bit min for group `is` (0..7) from the packed scales[12] array.
float extract_min(uint ib, uint is) {
    uint mbidx0 = is + 4u;
    uint mbidx1 = (is < 4u) ? (is + 4u) : is;
    uint mbidxmask0 = (is < 4u) ? 0xFu : 0xF0u;
    uint mbidxshift0 = (is < 4u) ? 0u : 4u;
    uint mbidxmask1 = (is < 4u) ? 0x30u : 0xC0u;
    uint mbidxshift1 = (is < 4u) ? 0u : 2u;
    return float(uint8_t(
        ((data_a[ib].scales[mbidx0] & uint8_t(mbidxmask0)) >> mbidxshift0) |
        ((data_a[ib].scales[mbidx1] & uint8_t(mbidxmask1)) >> mbidxshift1)
    ));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sg_id = gl_SubgroupID;
    uint sg_m = sg_id / SG_N;
    uint sg_n = sg_id % SG_N;

    uint n_tiles_n = (uint(npos) + BN - 1u) / BN;
    uint tile_n = gl_WorkGroupID.x % n_tiles_n;
    uint tile_m = gl_WorkGroupID.x / n_tiles_n;

    uint wg_m = tile_m * BM;
    uint wg_n = tile_n * BN;
    uint M = uint(rows);
    uint K = uint(cols);
    uint N = uint(npos);
    uint num_blocks_per_row = K / 256u;

    coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[CMS_M * CMS_N];
    for (uint i = 0u; i < CMS_M * CMS_N; i++)
        acc[i] = coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);

    // A loads: BM * BK/2 = 64*16 = 1024 f16vec2 / 128 threads = 8 per thread
    // B loads: same
    const uint LOAD_COUNT = (BM * (BK / 2u)) / 128u;  // 8

    for (uint k_base = 0u; k_base < K; k_base += BK) {
        // === Load A tile: dequantize Q4_K weights into smA ===
        // Each thread dequantizes 8 f16vec2 = 16 scalar values.
        // BK=32 = one scale group within a Q4_K super-block.
        for (uint e = 0u; e < LOAD_COUNT; e++) {
            uint idx = e * 128u + tid;
            uint row = idx / (BK / 2u);     // 0..63 row within BM
            uint col2 = idx % (BK / 2u);    // 0..15 vec2 index within BK
            uint m_global = wg_m + row;
            uint k_global = k_base + col2 * 2u;

            f16vec2 val = f16vec2(0.0, 0.0);
            if (m_global < M && k_global < K) {
                // Which Q4_K block and position within it
                uint block_k = k_global / 256u;
                uint local_k = k_global % 256u;
                uint ib = m_global * num_blocks_per_row + block_k;

                // Which scale group: 8 groups of 32 within a 256-element block
                uint group = local_k / 32u;      // 0..7
                uint intra = local_k % 32u;       // 0..31

                // Dequantize: value = d * scale * quant - dmin * min_scale
                float d_val = float(data_a[ib].d);
                float dmin_val = float(data_a[ib].dmin);
                float sc = extract_scale(ib, group);
                float mn = extract_min(ib, group);
                float d = d_val * sc;
                float m = -dmin_val * mn;

                // Q4_K layout within qs[128]:
                // n (0..3) selects a 32-byte chunk, b (0..1) selects low/high nibble
                uint n = local_k / 64u;            // 0..3
                uint b = (local_k % 64u) / 32u;    // 0..1
                uint rem32 = local_k % 32u;
                uint qsi = n * 32u + rem32;         // byte index into qs[128]

                // Extract two 4-bit quants for the vec2
                uint q0_byte = uint(data_a[ib].qs[qsi]);
                float q0 = float((q0_byte >> (b * 4u)) & 0xFu);

                // Second element (col2*2+1)
                uint k_global2 = k_global + 1u;
                float q1 = 0.0;
                if (k_global2 < K) {
                    uint local_k2 = k_global2 % 256u;
                    uint n2 = local_k2 / 64u;
                    uint b2 = (local_k2 % 64u) / 32u;
                    uint rem32_2 = local_k2 % 32u;
                    uint qsi2 = n2 * 32u + rem32_2;
                    uint q1_byte = uint(data_a[ib].qs[qsi2]);
                    q1 = float((q1_byte >> (b2 * 4u)) & 0xFu);
                    // Note: both elements are in the same scale group since BK=32
                }

                val.x = float16_t(fma(d, q0, m));
                val.y = float16_t(fma(d, q1, m));
            }
            smA[row * SHMEM_STRIDE + col2] = val;
        }

        // === Load B tile: FP32 input → smB (same as BF16 GEMM) ===
        for (uint e = 0u; e < LOAD_COUNT; e++) {
            uint idx = e * 128u + tid;
            uint row = idx / (BK / 2u);
            uint col2 = idx % (BK / 2u);
            uint n_global = wg_n + row;
            uint k_global = k_base + col2 * 2u;
            f16vec2 val = f16vec2(0.0, 0.0);
            if (n_global < N && k_global + 1u < K) {
                val.x = float16_t(data_b[n_global * K + k_global]);
                val.y = float16_t(data_b[n_global * K + k_global + 1u]);
            } else if (n_global < N && k_global < K) {
                val.x = float16_t(data_b[n_global * K + k_global]);
            }
            smB[row * SHMEM_STRIDE + col2] = val;
        }

        barrier();

        // === Compute with cooperative matrix ===
        for (uint kt = 0u; kt < N_K_TILES; kt++) {
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matA[CMS_M];
            for (uint am = 0u; am < CMS_M; am++) {
                uint sm_row = sg_m * CMS_M * TM + am * TM;
                coopMatLoad(matA[am], smA, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }

            for (uint an = 0u; an < CMS_N; an++) {
                coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matB;
                uint sm_row = sg_n * CMS_N * TN + an * TN;
                coopMatLoad(matB, smB, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

                for (uint am = 0u; am < CMS_M; am++) {
                    acc[am * CMS_N + an] = coopMatMulAdd(matA[am], matB, acc[am * CMS_N + an]);
                }
            }
        }

        barrier();
    }

    // Store: column-major [N, M]
    for (uint am = 0u; am < CMS_M; am++) {
        for (uint an = 0u; an < CMS_N; an++) {
            uint base_m = wg_m + sg_m * CMS_M * TM + am * TM;
            uint base_n = wg_n + sg_n * CMS_N * TN + an * TN;
            if (base_m < M && base_n < N) {
                coopMatStore(acc[am * CMS_N + an], out_data, base_n * M + base_m, M,
                             gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
    }
}
