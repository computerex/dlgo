#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : enable

// Batched Q4_K × Q8_1 dp4a GEMM — multi-token for weight reuse.
//
// Combines NT tokens per workgroup (weight loaded once) with dp4a
// dot product (~4× throughput over scalar FP32 for accumulation).
//
// 128 threads = 4 subgroups, each subgroup handles one row.
// 32 threads per subgroup, 8 sub-blocks per Q4_K super-block.
// 4 super-blocks per iteration stride.
//
// WorkGroupID.x = row tile (stride 4)
// WorkGroupID.y = token tile (stride NT)
// Push constants: rows, cols, npos

#define NT 32u   // tokens per workgroup

layout(local_size_x = 128) in;

struct block_q4_k {
    float16_t d;
    float16_t dmin;
    uint8_t scales[12];
    uint8_t qs[128];
};

struct block_q4_k_p32 {
    float16_t d;
    float16_t dmin;
    uint8_t scales[12];
    uint32_t qs[32];
};

struct block_q8_1 {
    float16_t d;
    float16_t s;
    int32_t qs[8];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q4_k data_a[]; };
layout(scalar, set = 0, binding = 1) readonly buffer AP32 { block_q4_k_p32 data_a_p32[]; };
layout(set = 0, binding = 2) readonly buffer B { block_q8_1 data_b[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int npos;
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sub_id = tid >> 5;       // subgroup 0-3
    uint sub_tid = tid & 31u;     // thread within subgroup
    uint row = gl_WorkGroupID.x * 4u + sub_id;
    uint first_pos = gl_WorkGroupID.y * NT;

    if (row >= uint(rows)) return;

    uint ncols = uint(cols);
    uint num_sb = ncols >> 8;               // Q4_K super-blocks per row
    uint q8_bpr = num_sb * 8u;             // Q8_1 blocks per row (cols/32)

    if (first_pos >= uint(npos)) return;
    uint npos_u = uint(npos);

    uint sb_local = sub_tid & 7u;   // sub-block within super-block (0-7)
    uint sb_stride = sub_tid >> 3;  // super-block offset (0-3)
    uint qs_base = (sb_local >> 1) * 8u;
    uint shift = (sb_local & 1u) * 4u;

    float acc[NT];
    [[unroll]] for (uint t = 0u; t < NT; t++) acc[t] = 0.0;

    for (uint i = sb_stride; i < num_sb; i += 4u) {
        uint ib = row * num_sb + i;

        // Load weight data ONCE (reused across all NT tokens)
        float d_val = float(data_a[ib].d);
        float dmin_val = float(data_a[ib].dmin);

        uint sc, m;
        if (sb_local < 4u) {
            sc = uint(data_a[ib].scales[sb_local]) & 0x3Fu;
            m = uint(data_a[ib].scales[sb_local + 4u]) & 0x3Fu;
        } else {
            uint s_hi = uint(data_a[ib].scales[sb_local + 4u]);
            uint s_lo_0 = uint(data_a[ib].scales[sb_local - 4u]);
            uint s_lo_4 = uint(data_a[ib].scales[sb_local]);
            sc = (s_hi & 0xFu) | ((s_lo_0 & 0xC0u) >> 2);
            m  = (s_hi >> 4)   | ((s_lo_4 & 0xC0u) >> 2);
        }

        // Pre-extract weight nibbles for dp4a
        int32_t a_vals[8];
        [[unroll]] for (uint j = 0u; j < 8u; j++)
            a_vals[j] = int32_t((data_a_p32[ib].qs[qs_base + j] >> shift) & 0x0F0F0F0Fu);

        float d_sc = d_val * float(sc);
        float dm_m = dmin_val * float(m);

        // Process each token with dp4a (compile-time unrolled)
        [[unroll]] for (uint t = 0u; t < NT; t++) {
            if (first_pos + t >= npos_u) continue;
            uint b_ib = (first_pos + t) * q8_bpr + i * 8u + sb_local;
            float d_b = float(data_b[b_ib].d);
            float s_b = float(data_b[b_ib].s);

            int32_t bqs[8];
            [[unroll]] for (uint j = 0u; j < 8u; j++)
                bqs[j] = data_b[b_ib].qs[j];

            int dp_sum = 0;
            [[unroll]] for (uint j = 0u; j < 8u; j++)
                dp_sum += dotPacked4x8EXT(a_vals[j], bqs[j]);

            acc[t] += d_sc * float(dp_sum) * d_b - dm_m * s_b;
        }
    }

    // Subgroup reduction for each token
    [[unroll]] for (uint t = 0u; t < NT; t++)
        acc[t] = subgroupAdd(acc[t]);

    if (gl_SubgroupInvocationID == 0u) {
        [[unroll]] for (uint t = 0u; t < NT; t++) {
            if (first_pos + t < npos_u)
                out_data[(first_pos + t) * uint(rows) + row] = acc[t];
        }
    }
}
