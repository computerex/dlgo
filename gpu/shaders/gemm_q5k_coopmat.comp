#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q5_K-weight × FP32-input GEMM using cooperative matrix (tensor cores).
// Tile: BM=64, BN=128, BK=32.  128 threads = 4 subgroups in 2×2 layout.
// Each subgroup: 2×4 coopmat 16×16 tiles → 32×64 output.
// BK=32 == exactly one Q5_K group, so the group index (and hence the scale/min
// and the qs nibble / qh bit positions) is uniform over the whole k-tile.

#define BM     64u
#define BN     128u
#define BK     32u
#define SHMEM_STRIDE (BK / 2u + 4u)  // = 20 f16vec2 per row
#define TM     16u
#define TN     16u
#define TK     16u
#define SG_M   2u
#define SG_N   2u
#define CMS_M  2u
#define CMS_N  4u
#define N_K_TILES (BK / TK)  // = 2

layout(local_size_x = 128) in;

// Q5_K block: 256 elements, 176 bytes. qh/qs are declared as 32-bit words so the
// dequant can pull four adjacent quant bytes with a single aligned load. The
// block is 176 bytes (16-byte aligned members), so every word load is aligned.
struct block_q5_k {
    float16_t d;
    float16_t dmin;
    uint8_t   scales[12];
    uint32_t  qh32[8];    // 32 bytes (== uint8_t qh[32])
    uint32_t  qs32[32];   // 128 bytes (== uint8_t qs[128])
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q5_k data_a[]; };
layout(set = 0, binding = 2) readonly buffer B { vec4 data_b4[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int npos;
};

shared f16vec2 smA[BM * SHMEM_STRIDE];
shared f16vec2 smB[BN * SHMEM_STRIDE];
shared float out_stage[BM * BN];

// Extract 6-bit scale for group `is` (0..7) — identical to Q4_K.
float extract_scale(uint ib, uint is) {
    uint scidx0 = (is < 4u) ? is : (is + 4u);
    uint scidx1 = (is < 4u) ? is : (is - 4u);
    uint scidxmask1 = (is < 4u) ? 0x30u : 0xC0u;
    uint scidxshift1 = (is < 4u) ? 0u : 2u;
    return float(uint8_t(
        (data_a[ib].scales[scidx0] & 0xFu) |
        ((data_a[ib].scales[scidx1] & uint8_t(scidxmask1)) >> scidxshift1)
    ));
}

// Extract 6-bit min for group `is` (0..7) — identical to Q4_K.
float extract_min(uint ib, uint is) {
    uint mbidx0 = is + 4u;
    uint mbidx1 = (is < 4u) ? (is + 4u) : is;
    uint mbidxmask0 = (is < 4u) ? 0xFu : 0xF0u;
    uint mbidxshift0 = (is < 4u) ? 0u : 4u;
    uint mbidxmask1 = (is < 4u) ? 0x30u : 0xC0u;
    uint mbidxshift1 = (is < 4u) ? 0u : 2u;
    return float(uint8_t(
        ((data_a[ib].scales[mbidx0] & uint8_t(mbidxmask0)) >> mbidxshift0) |
        ((data_a[ib].scales[mbidx1] & uint8_t(mbidxmask1)) >> mbidxshift1)
    ));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sg_id = gl_SubgroupID;
    uint sg_m = sg_id / SG_N;
    uint sg_n = sg_id % SG_N;

    // Dispatch order: tile_m varies fastest. A scheduling wave then covers all
    // M-tiles for a single N-tile, so the (small) activation tile for that N is
    // reused from L2 while the weights stay resident.
    uint n_tiles_m = (uint(rows) + BM - 1u) / BM;
    uint tile_m = gl_WorkGroupID.x % n_tiles_m;
    uint tile_n = gl_WorkGroupID.x / n_tiles_m;

    uint wg_m = tile_m * BM;
    uint wg_n = tile_n * BN;
    uint M = uint(rows);
    uint K = uint(cols);
    uint N = uint(npos);
    uint num_blocks_per_row = K / 256u;

    coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[CMS_M * CMS_N];
    for (uint i = 0u; i < CMS_M * CMS_N; i++)
        acc[i] = coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);

    const uint LOAD_COUNT_A = (BM * 8u) / 128u;        // 4  (A path: 4 k per thread)
    const uint LOAD_COUNT_B = (BN * 8u) / 128u;        // 8  (B path: 4 k per thread)

    for (uint k_base = 0u; k_base < K; k_base += BK) {
        // === Load A tile: dequantize Q5_K weights into smA ===
        // BK=32 == one Q5_K group, so group/grp/sub/bit are uniform per k-tile.
        // Each thread produces 4 consecutive k-values from two aligned 32-bit
        // loads, and the nibble/bit extraction is done with SWAR.
        uint a_group   = (k_base % 256u) / 32u;  // 0..7
        uint a_grp     = a_group / 2u;           // 0..3  qs half
        uint a_sub     = a_group & 1u;           // nibble select
        uint a_bit     = a_group;                // qh bit index
        uint a_block_k = k_base / 256u;

        for (uint e = 0u; e < LOAD_COUNT_A; e++) {
            uint idx = e * 128u + tid;
            uint row = idx >> 3u;        // 0..63 row within BM
            uint col4 = idx & 7u;        // 0..7 group of 4 k-values
            uint m_global = wg_m + row;

            f16vec2 v0 = f16vec2(0.0, 0.0);
            f16vec2 v1 = f16vec2(0.0, 0.0);
            if (m_global < M) {
                uint ib = m_global * num_blocks_per_row + a_block_k;
                float d_val = float(data_a[ib].d);
                float dmin_val = float(data_a[ib].dmin);
                float dd = d_val * extract_scale(ib, a_group);
                float mm = -dmin_val * extract_min(ib, a_group);

                uint qs32 = data_a[ib].qs32[a_grp * 8u + col4];
                uint qh32 = data_a[ib].qh32[col4];
                uint q4v  = (qs32 >> (a_sub * 4u)) & 0x0F0F0F0Fu;
                uint qhv  = (qh32 >> a_bit) & 0x01010101u;
                uint qv   = q4v | (qhv << 4u);

                v0 = f16vec2(float16_t(fma(dd, float(qv & 0xFFu), mm)),
                             float16_t(fma(dd, float((qv >> 8u) & 0xFFu), mm)));
                v1 = f16vec2(float16_t(fma(dd, float((qv >> 16u) & 0xFFu), mm)),
                             float16_t(fma(dd, float((qv >> 24u) & 0xFFu), mm)));
            }
            smA[row * SHMEM_STRIDE + col4 * 2u]      = v0;
            smA[row * SHMEM_STRIDE + col4 * 2u + 1u] = v1;
        }

        // === Load B tile: FP32 input → smB (vec4 loads) ===
        for (uint e = 0u; e < LOAD_COUNT_B; e++) {
            uint idx = e * 128u + tid;
            uint row = idx >> 3u;
            uint col4 = idx & 7u;
            uint n_global = wg_n + row;
            f16vec2 v0 = f16vec2(0.0, 0.0);
            f16vec2 v1 = f16vec2(0.0, 0.0);
            if (n_global < N) {
                vec4 x4 = data_b4[(n_global * K + k_base + col4 * 4u) >> 2u];
                v0 = f16vec2(float16_t(x4.x), float16_t(x4.y));
                v1 = f16vec2(float16_t(x4.z), float16_t(x4.w));
            }
            smB[row * SHMEM_STRIDE + col4 * 2u]      = v0;
            smB[row * SHMEM_STRIDE + col4 * 2u + 1u] = v1;
        }

        barrier();

        // === Compute with cooperative matrix ===
        for (uint kt = 0u; kt < N_K_TILES; kt++) {
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matA[CMS_M];
            for (uint am = 0u; am < CMS_M; am++) {
                uint sm_row = sg_m * CMS_M * TM + am * TM;
                coopMatLoad(matA[am], smA, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }

            for (uint an = 0u; an < CMS_N; an++) {
                coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matB;
                uint sm_row = sg_n * CMS_N * TN + an * TN;
                coopMatLoad(matB, smB, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

                for (uint am = 0u; am < CMS_M; am++) {
                    acc[am * CMS_N + an] = coopMatMulAdd(matA[am], matB, acc[am * CMS_N + an]);
                }
            }
        }

        barrier();
    }

    // Stage through shared memory to allow per-element bounds checking.
    // coopMatStore always writes a full 16×16 tile; without this, edge tiles
    // where base_n+16 > N would write past the output buffer causing TDR.
    for (uint am = 0u; am < CMS_M; am++) {
        for (uint an = 0u; an < CMS_N; an++) {
            uint sm_m = sg_m * CMS_M * TM + am * TM;
            uint sm_n = sg_n * CMS_N * TN + an * TN;
            coopMatStore(acc[am * CMS_N + an], out_stage, sm_n * BM + sm_m, BM,
                         gl_CooperativeMatrixLayoutColumnMajor);
        }
    }

    barrier();

    for (uint e = 0u; e < (BM * BN) / 128u; e++) {
        uint idx = e * 128u + tid;
        uint local_m = idx % BM;
        uint local_n = idx / BM;
        uint gm = wg_m + local_m;
        uint gn = wg_n + local_n;
        if (gm < M && gn < N) {
            out_data[gn * M + gm] = out_stage[local_n * BM + local_m];
        }
    }
}
