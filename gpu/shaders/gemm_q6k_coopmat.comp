#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q6_K-weight × FP32-input GEMM using cooperative matrix (tensor cores).
// Tile: BM=64, BN=128, BK=32.  128 threads = 4 subgroups in 2×2 layout.
// Each subgroup: 2×4 coopmat 16×16 tiles → 32×64 output.
// BK=32 aligns with exactly one Q6_K quadrant (v_im/quadrant uniform per k-tile).

#define BM     64u
#define BN     128u
#define BK     32u
#define SHMEM_STRIDE (BK / 2u + 4u)  // = 20 f16vec2 per row
#define TM     16u
#define TN     16u
#define TK     16u
#define SG_M   2u
#define SG_N   2u
#define CMS_M  2u
#define CMS_N  4u
#define N_K_TILES (BK / TK)  // = 2

layout(local_size_x = 128) in;

// Q6_K block: 256 elements, 210 bytes
struct block_q6_k {
    uint8_t ql[128];     // low 4 bits
    uint8_t qh[64];      // high 2 bits
    int8_t  scales[16];  // signed scales, one per 16 elements
    float16_t d;         // super-block scale
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q6_k data_a[]; };
layout(set = 0, binding = 2) readonly buffer B { vec4 data_b4[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int npos;
};

shared f16vec2 smA[BM * SHMEM_STRIDE];
shared f16vec2 smB[BN * SHMEM_STRIDE];
shared float out_stage[BM * BN];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sg_id = gl_SubgroupID;
    uint sg_m = sg_id / SG_N;
    uint sg_n = sg_id % SG_N;

    // Dispatch order: tile_m varies fastest. A scheduling wave then covers all
    // M-tiles for a single N-tile, so the (small) activation tile for that N is
    // reused from L2 while the weights stay resident. Measured ~1.14x vs the
    // original tile_n-fastest order.
    uint n_tiles_m = (uint(rows) + BM - 1u) / BM;
    uint tile_m = gl_WorkGroupID.x % n_tiles_m;
    uint tile_n = gl_WorkGroupID.x / n_tiles_m;

    uint wg_m = tile_m * BM;
    uint wg_n = tile_n * BN;
    uint M = uint(rows);
    uint K = uint(cols);
    uint N = uint(npos);
    uint num_blocks_per_row = K / 256u;

    coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[CMS_M * CMS_N];
    for (uint i = 0u; i < CMS_M * CMS_N; i++)
        acc[i] = coopmat<float32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);

    const uint LOAD_COUNT_A = (BM * 8u) / 128u;        // 4  (A path: 4 k per thread)
    const uint LOAD_COUNT_B = (BN * 8u) / 128u;        // 4  (B path: 4 k per thread)

    for (uint k_base = 0u; k_base < K; k_base += BK) {
        // === Load A tile: dequantize Q6_K weights into smA ===
        // BK=32 == exactly one Q6_K quadrant, so v_im and quadrant are uniform
        // across the whole k-tile. That lets us hoist the (previously per-element)
        // quadrant branch and its now-dead loads, and have each thread process 4
        // consecutive k-values instead of 2. The old per-element path loaded both
        // ql bytes even when only one was used, and re-evaluated the branch and
        // scale index for every element.
        uint k_in_block = k_base % 256u;
        uint a_vim      = k_in_block >> 7u;             // 0/1
        uint a_q        = (k_in_block >> 5u) & 3u;      // quadrant 0..3
        uint a_block_k  = k_base >> 8u;                 // k_base / 256
        uint a_ql_base  = 64u * a_vim + (a_q & 1u) * 32u;
        uint a_qh_base  = 32u * a_vim;
        uint a_qh_shift = 2u * a_q;
        uint a_nib      = (a_q >> 1u) * 4u;             // 0 for q<2, 4 for q>=2
        uint a_sc_off   = 8u * a_vim + 2u * a_q;

        for (uint e = 0u; e < LOAD_COUNT_A; e++) {
            uint idx = e * 128u + tid;
            uint row = idx >> 3u;        // 0..63 row within BM
            uint col4 = idx & 7u;        // 0..7 group of 4 k-values
            uint m_global = wg_m + row;

            f16vec2 v0 = f16vec2(0.0, 0.0);
            f16vec2 v1 = f16vec2(0.0, 0.0);
            if (m_global < M) {
                uint ib = m_global * num_blocks_per_row + a_block_k;
                float d_val = float(data_a[ib].d);
                float sc = float(data_a[ib].scales[a_sc_off + (col4 >> 2u)]);
                uint ql_o = a_ql_base + col4 * 4u;
                uint qh_o = a_qh_base + col4 * 4u;
                uint q6;
                q6 = ((uint(data_a[ib].ql[ql_o + 0u]) >> a_nib) & 0xFu)
                   | (((uint(data_a[ib].qh[qh_o + 0u]) >> a_qh_shift) & 0x3u) << 4u);
                float f0 = d_val * sc * (float(q6) - 32.0);
                q6 = ((uint(data_a[ib].ql[ql_o + 1u]) >> a_nib) & 0xFu)
                   | (((uint(data_a[ib].qh[qh_o + 1u]) >> a_qh_shift) & 0x3u) << 4u);
                float f1 = d_val * sc * (float(q6) - 32.0);
                q6 = ((uint(data_a[ib].ql[ql_o + 2u]) >> a_nib) & 0xFu)
                   | (((uint(data_a[ib].qh[qh_o + 2u]) >> a_qh_shift) & 0x3u) << 4u);
                float f2 = d_val * sc * (float(q6) - 32.0);
                q6 = ((uint(data_a[ib].ql[ql_o + 3u]) >> a_nib) & 0xFu)
                   | (((uint(data_a[ib].qh[qh_o + 3u]) >> a_qh_shift) & 0x3u) << 4u);
                float f3 = d_val * sc * (float(q6) - 32.0);
                v0 = f16vec2(float16_t(f0), float16_t(f1));
                v1 = f16vec2(float16_t(f2), float16_t(f3));
            }
            smA[row * SHMEM_STRIDE + col4 * 2u]      = v0;
            smA[row * SHMEM_STRIDE + col4 * 2u + 1u] = v1;
        }

        // === Load B tile: FP32 input → smB (vec4 loads) ===
        // K is a multiple of 4 (Q6_K needs K%256==0), so 4 consecutive k-values
        // are 16-byte aligned and can be fetched with a single vec4 load.
        for (uint e = 0u; e < LOAD_COUNT_B; e++) {
            uint idx = e * 128u + tid;
            uint row = idx >> 3u;        // 0..63
            uint col4 = idx & 7u;        // 0..7 group of 4 k-values
            uint n_global = wg_n + row;
            f16vec2 v0 = f16vec2(0.0, 0.0);
            f16vec2 v1 = f16vec2(0.0, 0.0);
            if (n_global < N) {
                vec4 x4 = data_b4[(n_global * K + k_base + col4 * 4u) >> 2u];
                v0 = f16vec2(float16_t(x4.x), float16_t(x4.y));
                v1 = f16vec2(float16_t(x4.z), float16_t(x4.w));
            }
            smB[row * SHMEM_STRIDE + col4 * 2u]      = v0;
            smB[row * SHMEM_STRIDE + col4 * 2u + 1u] = v1;
        }

        barrier();

        // === Compute with cooperative matrix ===
        for (uint kt = 0u; kt < N_K_TILES; kt++) {
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> matA[CMS_M];
            for (uint am = 0u; am < CMS_M; am++) {
                uint sm_row = sg_m * CMS_M * TM + am * TM;
                coopMatLoad(matA[am], smA, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }

            for (uint an = 0u; an < CMS_N; an++) {
                coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> matB;
                uint sm_row = sg_n * CMS_N * TN + an * TN;
                coopMatLoad(matB, smB, sm_row * SHMEM_STRIDE + kt * (TK / 2u),
                            SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

                for (uint am = 0u; am < CMS_M; am++) {
                    acc[am * CMS_N + an] = coopMatMulAdd(matA[am], matB, acc[am * CMS_N + an]);
                }
            }
        }

        barrier();
    }

    // Stage through shared memory to allow per-element bounds checking.
    // coopMatStore always writes a full 16×16 tile; without this, edge tiles
    // where base_n+16 > N would write past the output buffer causing TDR.
    for (uint am = 0u; am < CMS_M; am++) {
        for (uint an = 0u; an < CMS_N; an++) {
            uint sm_m = sg_m * CMS_M * TM + am * TM;
            uint sm_n = sg_n * CMS_N * TN + an * TN;
            coopMatStore(acc[am * CMS_N + an], out_stage, sm_n * BM + sm_m, BM,
                         gl_CooperativeMatrixLayoutColumnMajor);
        }
    }

    barrier();

    for (uint e = 0u; e < (BM * BN) / 128u; e++) {
        uint idx = e * 128u + tid;
        uint local_m = idx % BM;
        uint local_n = idx / BM;
        uint gm = wg_m + local_m;
        uint gn = wg_n + local_n;
        if (gm < M && gn < N) {
            out_data[gn * M + gm] = out_stage[local_n * BM + local_m];
        }
    }
}
