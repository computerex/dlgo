#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_control_flow_attributes : enable

// IQ2_S matvec: 4 rows/WG, vec4 B loads, bitfield sign handling.
// Grid lookup via SSBO (1024 uvec2 entries, too large for compile-time constant).

layout(local_size_x = 128) in;

#define NUM_ROWS 4u
#define QUANT_K 256u

struct block_iq2_s {
    float16_t d;
    uint8_t qs[64];
    uint8_t qh[8];
    uint8_t scales[8];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer Weights { block_iq2_s data_a[]; };
layout(set = 0, binding = 2) readonly buffer X { float x_data[]; };
layout(set = 0, binding = 2) readonly buffer XV4 { vec4 data_b_v4[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint table_data[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

shared float tmpsh[NUM_ROWS][4];

vec4 grid_unpack(uint v) {
    return vec4(float(v & 0xFFu), float((v >> 8u) & 0xFFu),
                float((v >> 16u) & 0xFFu), float((v >> 24u) & 0xFFu));
}

void compute_outputs(uint first_row, uint num_rows) {
    const uint num_blocks_per_row = uint(cols) / QUANT_K;
    const uint blocks_per_wg = 128u / 16u;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid & 15u;
    const uint ix = tid / 16u;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) temp[n] = 0.0;

    uint nibble_shift = 4u * (itid & 1u);
    uint ib32 = itid / 2u;

    for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg) {
        uint y_idx = i * QUANT_K + 16u * itid;

        uint ibi = first_row * num_blocks_per_row + i;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            float d = float(data_a[ibi].d);
            uint sc_byte = uint(data_a[ibi].scales[ib32]);
            float db = d * (0.5 + float((sc_byte >> nibble_shift) & 0xFu)) * 0.25;

            uint qh_byte = uint(data_a[ibi].qh[ib32]);

            [[unroll]] for (uint l = 0; l < 2u; ++l) {
                uint qs_byte = uint(data_a[ibi].qs[ib32 * 4u + 2u * (itid & 1u) + l]);
                uint sign = uint(data_a[ibi].qs[32u + ib32 * 4u + 2u * (itid & 1u) + l]);
                uint high_bits = ((qh_byte >> (nibble_shift + 2u * l)) & 3u) << 8u;
                uint grid_idx = qs_byte | high_bits;

                uint glo = table_data[grid_idx * 2u];
                uint ghi = table_data[grid_idx * 2u + 1u];
                vec4 grid0 = grid_unpack(glo);
                vec4 grid1 = grid_unpack(ghi);

                vec4 b0 = data_b_v4[y_idx / 4u + 2u * l + 0u];
                vec4 b4 = data_b_v4[y_idx / 4u + 2u * l + 1u];

                float sum =
                    fma(b0.x, ((sign &   1u) != 0u) ? -grid0.x : grid0.x,
                    fma(b0.y, ((sign &   2u) != 0u) ? -grid0.y : grid0.y,
                    fma(b0.z, ((sign &   4u) != 0u) ? -grid0.z : grid0.z,
                    fma(b0.w, ((sign &   8u) != 0u) ? -grid0.w : grid0.w,
                    fma(b4.x, ((sign &  16u) != 0u) ? -grid1.x : grid1.x,
                    fma(b4.y, ((sign &  32u) != 0u) ? -grid1.y : grid1.y,
                    fma(b4.z, ((sign &  64u) != 0u) ? -grid1.z : grid1.z,
                    fma(b4.w, ((sign & 128u) != 0u) ? -grid1.w : grid1.w,
                    0.0))))))));

                temp[n] = fma(db, sum, temp[n]);
            }
            ibi += num_blocks_per_row;
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }
    if ((tid & 31u) == 0u) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            tmpsh[n][tid / 32u] = temp[n];
        }
    }
    barrier();
    if (tid == 0u) {
        for (uint n = 0; n < num_rows; ++n) {
            float total = 0.0;
            for (uint sg = 0; sg < 128u / 32u; ++sg) {
                total += tmpsh[n][sg];
            }
            if (first_row + n < uint(rows)) {
                out_data[first_row + n] = total;
            }
        }
    }
}

void main() {
    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    if (first_row >= uint(rows)) return;
    uint num_rows = min(NUM_ROWS, uint(rows) - first_row);
    compute_outputs(first_row, num_rows);
}
