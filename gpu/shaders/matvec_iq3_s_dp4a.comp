#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

// IQ3_S dp4a matvec: 512-entry SSBO grid, 9-bit indices, explicit 8-bit signs.
// Grid bytes (same as IQ3_XXS) are small integers, sign-applied range fits int8.

layout(local_size_x = 128) in;

#define NUM_ROWS 4u
#define QUANT_K 256u

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

struct block_iq3_s {
    float16_t d;
    uint8_t qs[64];
    uint8_t qh[8];
    uint8_t signs[32];
    uint8_t scales[4];
};

struct block_q8_1 {
    float16_t d;
    float16_t s;
    int32_t qs[8];
};

layout(binding = 0, scalar) buffer Out { float out_data[]; };
layout(binding = 1, scalar) readonly buffer Weights { block_iq3_s data_a[]; };
layout(binding = 2, scalar) readonly buffer B { block_q8_1 data_b[]; };
layout(binding = 3, scalar) readonly buffer Tables { uint table_data[]; };

shared uint iq3s_grid[512];
shared float tmpsh[NUM_ROWS][4];

void compute_outputs(uint first_row, uint num_rows) {
    const uint num_blocks_per_row = uint(cols) / QUANT_K;
    const uint blocks_per_wg = 128u / 16u;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid & 15u;
    const uint ix = tid / 16u;

    uint ib32 = itid / 2u;
    uint half_idx = itid & 1u;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) temp[n] = 0.0;

    for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg) {
        uint q8_blk = i * 8u + ib32;
        float d_b = float(data_b[q8_blk].d);
        int32_t bqs[4];
        [[unroll]] for (uint j = 0u; j < 4u; j++)
            bqs[j] = data_b[q8_blk].qs[half_idx * 4u + j];

        uint ibi = first_row * num_blocks_per_row + i;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            float d = float(data_a[ibi].d);
            uint sc_byte = uint(data_a[ibi].scales[ib32 / 2u]);
            float db = d * float(1u + 2u * ((ib32 & 1u) == 0u ? (sc_byte & 0xFu) : (sc_byte >> 4u)));

            uint qh = uint(data_a[ibi].qh[ib32]);

            int dp_sum = 0;
            [[unroll]] for (uint l = 0; l < 2u; ++l) {
                uint qs_off = ib32 * 8u;
                uint qs_idx = qs_off + 4u * half_idx + 2u * l;
                uint qs0 = uint(data_a[ibi].qs[qs_idx]);
                uint qs1 = uint(data_a[ibi].qs[qs_idx + 1u]);
                uint gridIdx0 = qs0 | ((qh << (8u - 2u * (2u * half_idx + l))) & 256u);
                uint gridIdx1 = qs1 | ((qh << (7u - 2u * (2u * half_idx + l))) & 256u);

                uint g0 = iq3s_grid[gridIdx0];
                uint g1 = iq3s_grid[gridIdx1];

                uint sign = uint(data_a[ibi].signs[ib32 * 4u + 2u * half_idx + l]);

                i8vec4 gv0 = i8vec4(unpack8(g0));
                if ((sign &   1u) != 0u) gv0.x = -gv0.x;
                if ((sign &   2u) != 0u) gv0.y = -gv0.y;
                if ((sign &   4u) != 0u) gv0.z = -gv0.z;
                if ((sign &   8u) != 0u) gv0.w = -gv0.w;

                i8vec4 gv1 = i8vec4(unpack8(g1));
                if ((sign &  16u) != 0u) gv1.x = -gv1.x;
                if ((sign &  32u) != 0u) gv1.y = -gv1.y;
                if ((sign &  64u) != 0u) gv1.z = -gv1.z;
                if ((sign & 128u) != 0u) gv1.w = -gv1.w;

                dp_sum += dotPacked4x8EXT(pack32(gv0), bqs[2u * l]);
                dp_sum += dotPacked4x8EXT(pack32(gv1), bqs[2u * l + 1u]);
            }

            temp[n] += db * d_b * float(dp_sum);
            ibi += num_blocks_per_row;
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }
    if ((tid & 31u) == 0u) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            tmpsh[n][tid / 32u] = temp[n];
        }
    }
    barrier();
    if (tid == 0u) {
        for (uint n = 0; n < num_rows; ++n) {
            float total = 0.0;
            for (uint sg = 0; sg < 128u / 32u; ++sg) {
                total += tmpsh[n][sg];
            }
            if (first_row + n < uint(rows)) {
                out_data[first_row + n] = total;
            }
        }
    }
}

void main() {
    uint first_row = NUM_ROWS * gl_WorkGroupID.x;

    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < 512u; i += 128u) {
        iq3s_grid[i] = table_data[i];
    }
    barrier();

    if (first_row >= uint(rows)) return;

    uint num_rows = min(NUM_ROWS, uint(rows) - first_row);
    compute_outputs(first_row, num_rows);
}
