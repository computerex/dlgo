shared uint iq3xxs_grid[256];
shared float tmpsh[NUM_ROWS][128];

vec4 grid_unpack(uint v) {
    return vec4(float(v & 0xFFu), float((v >> 8u) & 0xFFu),
                float((v >> 16u) & 0xFFu), float((v >> 24u) & 0xFFu));
}

// Rebuild signscale from two uint16 in qs[] (aux region at offset 64)
uint pack_signscale(uint bi, uint ib32) {
    uint lo = uint(data_a[bi].qs[64u + 4u * ib32])
            | (uint(data_a[bi].qs[64u + 4u * ib32 + 1u]) << 8u);
    uint hi = uint(data_a[bi].qs[64u + 4u * ib32 + 2u])
            | (uint(data_a[bi].qs[64u + 4u * ib32 + 3u]) << 8u);
    return lo | (hi << 16u);
}

void compute_outputs(uint first_row, uint num_rows) {
    const uint num_blocks_per_row = uint(cols) / QUANT_K;
    const uint blocks_per_wg = 128u / 16u; // 8 blocks processed in parallel
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid & 15u;  // 0..15 (16 threads per block)
    const uint ix = tid / 16u;    // which block within the WG

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) temp[n] = 0.0;

    for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg) {
        uint y_idx = i * QUANT_K + 16u * itid;
        uint ib32 = itid / 2u; // 0..7

        uint ibi = first_row * num_blocks_per_row + i;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            float d = float(data_a[ibi].d);
            uint signscale = pack_signscale(ibi, ib32);
            float db = d * 0.5 * (0.5 + float(signscale >> 28u));

            [[unroll]] for (uint l = 0; l < 2u; ++l) {
                uint qs0 = data_a[ibi].qs[8u * ib32 + 4u * (itid & 1u) + 2u * l];
                uint qs1 = data_a[ibi].qs[8u * ib32 + 4u * (itid & 1u) + 2u * l + 1u];
                uint sign = bitfieldExtract(signscale, 7 * int(2u * (itid & 1u) + l), 7);
                uint sign7 = bitCount(sign);
                vec4 grid0 = grid_unpack(iq3xxs_grid[qs0]);
                vec4 grid1 = grid_unpack(iq3xxs_grid[qs1]);

                vec4 b0 = data_b_v4[y_idx / 4u + 2u * l + 0u];
                vec4 b4 = data_b_v4[y_idx / 4u + 2u * l + 1u];

                float sum =
                    fma(b0.x, ((sign &   1u) != 0u) ? -grid0.x : grid0.x,
                    fma(b0.y, ((sign &   2u) != 0u) ? -grid0.y : grid0.y,
                    fma(b0.z, ((sign &   4u) != 0u) ? -grid0.z : grid0.z,
                    fma(b0.w, ((sign &   8u) != 0u) ? -grid0.w : grid0.w,
                    fma(b4.x, ((sign &  16u) != 0u) ? -grid1.x : grid1.x,
                    fma(b4.y, ((sign &  32u) != 0u) ? -grid1.y : grid1.y,
                    fma(b4.z, ((sign &  64u) != 0u) ? -grid1.z : grid1.z,
                    fma(b4.w, ((sign7 &  1u) != 0u) ? -grid1.w : grid1.w,
                    0.0))))))));

                temp[n] = fma(db, sum, temp[n]);
            }
            ibi += num_blocks_per_row;
        }
    }

    // Reduction: subgroupAdd + shared memory across subgroups
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }
    if ((tid & 31u) == 0u) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            tmpsh[n][tid / 32u] = temp[n];
        }
    }
    barrier();
    if (tid == 0u) {
        for (uint n = 0; n < num_rows; ++n) {
            float total = 0.0;
            for (uint sg = 0; sg < 128u / 32u; ++sg) {
                total += tmpsh[n][sg];
            }
            if (first_row + n < uint(rows)) {
                out_data[first_row + n] = total;
            }
        }
    }
}

void main() {
    uint first_row = NUM_ROWS * gl_WorkGroupID.x;

    // Copy IQ3_XXS grid into shared memory (one-time per workgroup)
    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < 256u; i += 128u) {
        iq3xxs_grid[i] = iq3xxs_grid_const[i];
    }
    barrier();

    if (first_row >= uint(rows)) return;

    uint num_rows = min(NUM_ROWS, uint(rows) - first_row);
    compute_outputs(first_row, num_rows);
}
