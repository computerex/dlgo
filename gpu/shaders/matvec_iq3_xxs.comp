#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

// IQ3_XXS matvec: ported from llama.cpp mul_mat_vec_iq3_xxs.comp
// Key optimizations vs previous version:
//   - Grid table in shared memory (one-time copy, not SSBO every iteration)
//   - vec4 loads for input vector B
//   - 4 output rows per workgroup (was 2)
//   - Signs via bitfieldExtract + bitCount (ALU, no table lookup)

layout(local_size_x = 128) in;

#define NUM_ROWS 4u
#define QUANT_K 256u

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

struct block_iq3_xxs {
    float16_t d;
    uint8_t qs[96];
};

layout(binding = 0, scalar) buffer Out     { float out_data[]; };
layout(binding = 1, scalar) buffer Weights { block_iq3_xxs data_a[]; };
layout(binding = 2, scalar) buffer X       { float x_data[];  };
layout(binding = 2) buffer XV4             { vec4  data_b_v4[]; };

