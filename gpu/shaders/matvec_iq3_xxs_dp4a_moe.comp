#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

// IQ3_XXS dp4a MoE variant: processes n_used experts in one dispatch.
// gl_WorkGroupID.y = expert slot (0..n_used-1).

layout(local_size_x = 128) in;

#define NUM_ROWS 4u
#define QUANT_K 256u

layout(push_constant) uniform Params {
    int rows;
    int cols;
    int expert_stride;
    int base_offset;
    int shared_input;
};

struct block_iq3_xxs {
    float16_t d;
    uint8_t qs[96];
};

struct block_q8_1 {
    float16_t d;
    float16_t s;
    int32_t qs[8];
};

layout(binding = 0, scalar) buffer Out { float out_data[]; };
layout(binding = 1, scalar) readonly buffer Weights { block_iq3_xxs data_a[]; };
layout(binding = 2, scalar) readonly buffer B { block_q8_1 data_b[]; };
layout(binding = 3, scalar) readonly buffer Indices { float expert_indices[]; };

