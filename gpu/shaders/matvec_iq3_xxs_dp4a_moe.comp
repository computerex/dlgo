shared uint iq3xxs_grid[256];
shared float tmpsh[NUM_ROWS][4];

uint pack_signscale(uint bi, uint ib32) {
    uint lo = uint(data_a[bi].qs[64u + 4u * ib32])
            | (uint(data_a[bi].qs[64u + 4u * ib32 + 1u]) << 8u);
    uint hi = uint(data_a[bi].qs[64u + 4u * ib32 + 2u])
            | (uint(data_a[bi].qs[64u + 4u * ib32 + 3u]) << 8u);
    return lo | (hi << 16u);
}

void compute_outputs(uint first_row, uint num_rows, uint expert_offset, uint q8_off, uint slot) {
    const uint num_blocks_per_row = uint(cols) / QUANT_K;
    const uint num_q8_blocks = uint(cols) >> 5;
    const uint blocks_per_wg = 128u / 16u;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid & 15u;
    const uint ix = tid / 16u;

    uint ib32 = itid / 2u;
    uint half_idx = itid & 1u;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) temp[n] = 0.0;

    for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg) {
        uint q8_blk = q8_off + i * 8u + ib32;
        float d_b = float(data_b[q8_blk].d);
        int32_t bqs[4];
        [[unroll]] for (uint j = 0u; j < 4u; j++)
            bqs[j] = data_b[q8_blk].qs[half_idx * 4u + j];

        uint ibi = expert_offset + first_row * num_blocks_per_row + i;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            float d = float(data_a[ibi].d);
            uint signscale = pack_signscale(ibi, ib32);
            float db = d * 0.5 * (0.5 + float(signscale >> 28u));

            int dp_sum = 0;
            [[unroll]] for (uint l = 0; l < 2u; ++l) {
                uint qs0 = data_a[ibi].qs[8u * ib32 + 4u * half_idx + 2u * l];
                uint qs1 = data_a[ibi].qs[8u * ib32 + 4u * half_idx + 2u * l + 1u];
                uint sign = bitfieldExtract(signscale, 7 * int(2u * half_idx + l), 7);
                uint sign7 = bitCount(sign);

                uint g0 = iq3xxs_grid[qs0];
                uint g1 = iq3xxs_grid[qs1];

                i8vec4 gv0 = i8vec4(unpack8(g0));
                if ((sign &  1u) != 0u) gv0.x = -gv0.x;
                if ((sign &  2u) != 0u) gv0.y = -gv0.y;
                if ((sign &  4u) != 0u) gv0.z = -gv0.z;
                if ((sign &  8u) != 0u) gv0.w = -gv0.w;

                i8vec4 gv1 = i8vec4(unpack8(g1));
                if ((sign & 16u) != 0u) gv1.x = -gv1.x;
                if ((sign & 32u) != 0u) gv1.y = -gv1.y;
                if ((sign & 64u) != 0u) gv1.z = -gv1.z;
                if ((sign7 & 1u) != 0u) gv1.w = -gv1.w;

                dp_sum += dotPacked4x8EXT(pack32(gv0), bqs[2u * l]);
                dp_sum += dotPacked4x8EXT(pack32(gv1), bqs[2u * l + 1u]);
            }

            temp[n] += db * d_b * float(dp_sum);
            ibi += num_blocks_per_row;
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        temp[n] = subgroupAdd(temp[n]);
    }
    if ((tid & 31u) == 0u) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            tmpsh[n][tid / 32u] = temp[n];
        }
    }
    barrier();
    if (tid == 0u) {
        for (uint n = 0; n < num_rows; ++n) {
            float total = 0.0;
            for (uint sg = 0; sg < 128u / 32u; ++sg) {
                total += tmpsh[n][sg];
            }
            if (first_row + n < uint(rows)) {
                out_data[slot * uint(rows) + first_row + n] = total;
            }
        }
    }
}

void main() {
    uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    uint slot = gl_WorkGroupID.y;

    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < 256u; i += 128u) {
        iq3xxs_grid[i] = iq3xxs_grid_const[i];
    }
    barrier();

    if (first_row >= uint(rows)) return;

    int eidx = int(expert_indices[slot]);
    uint expert_offset = uint(base_offset) + uint(eidx) * uint(expert_stride);
    uint num_q8_blocks = uint(cols) >> 5;
    uint q8_off = (shared_input != 0) ? 0u : (slot * num_q8_blocks);

    uint num_rows = min(NUM_ROWS, uint(rows) - first_row);
    compute_outputs(first_row, num_rows, expert_offset, q8_off, slot);
}
