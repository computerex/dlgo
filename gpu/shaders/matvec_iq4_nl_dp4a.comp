#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

// IQ4_NL dp4a matvec: kvalues[16] are int8-range.
// 18-byte blocks of 32 values each. 4 threads per block, all 128 active.

layout(local_size_x = 128) in;

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

struct block_q8_1 {
    float16_t d;
    float16_t s;
    int32_t qs[8];
};

layout(binding = 0, scalar) buffer Out { float out_data[]; };
layout(binding = 1, scalar) readonly buffer Weights { uint8_t weight_bytes[]; };
layout(binding = 2, scalar) readonly buffer B { block_q8_1 data_b[]; };

const int kvalues[16] = int[16](
    -127, -104, -83, -65, -49, -35, -22, -10,
    1, 13, 25, 38, 53, 69, 89, 113
);

shared float shared_sums[4];

void main() {
    const uint row_pair = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;
    const uint num_blocks = uint(cols) / 32u;
    const uint block_bytes = 18u;

    uint blk_tid = tid / 4u;   // 0..31: which block slot
    uint il = tid & 3u;        // 0..3: which 4-byte group within block

    for (uint n = 0u; n < 2u; n++) {
        uint row = row_pair * 2u + n;
        if (row >= uint(rows)) {
            if (n == 0u) out_data[row] = 0.0;
            continue;
        }

        float acc = 0.0;

        for (uint b = blk_tid; b < num_blocks; b += 32u) {
            uint bi = row * num_blocks + b;
            uint byte_off = bi * block_bytes;

            uint lo_byte = uint(weight_bytes[byte_off]);
            uint hi_byte = uint(weight_bytes[byte_off + 1u]);
            float d = unpackHalf2x16(lo_byte | (hi_byte << 8u)).x;

            float d_b = float(data_b[b].d);
            int32_t bqs_lo = data_b[b].qs[il];
            int32_t bqs_hi = data_b[b].qs[4u + il];

            uint qs_base = byte_off + 2u + il * 4u;
            uint qb0 = uint(weight_bytes[qs_base]);
            uint qb1 = uint(weight_bytes[qs_base + 1u]);
            uint qb2 = uint(weight_bytes[qs_base + 2u]);
            uint qb3 = uint(weight_bytes[qs_base + 3u]);

            i8vec4 w_lo = i8vec4(kvalues[qb0 & 0xFu], kvalues[qb1 & 0xFu],
                                  kvalues[qb2 & 0xFu], kvalues[qb3 & 0xFu]);
            i8vec4 w_hi = i8vec4(kvalues[qb0 >> 4u], kvalues[qb1 >> 4u],
                                  kvalues[qb2 >> 4u], kvalues[qb3 >> 4u]);

            int dp = dotPacked4x8EXT(pack32(w_lo), bqs_lo)
                   + dotPacked4x8EXT(pack32(w_hi), bqs_hi);

            acc += d * d_b * float(dp);
        }

        acc = subgroupAdd(acc);

        if (gl_SubgroupInvocationID == 0u) {
            shared_sums[gl_SubgroupID] = acc;
        }
        barrier();

        if (tid == 0u) {
            float total = 0.0;
            for (uint i = 0u; i < 4u; i++) {
                total += shared_sums[i];
            }
            out_data[row] = total;
        }
        barrier();
    }
}
