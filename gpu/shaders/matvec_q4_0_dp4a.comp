#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : enable

// Q4_0 weights x Q8_1 input using dp4a, ported from llama.cpp style.
// All 128 threads cooperate on NUM_ROWS=2 rows (hybrid subgroup+shmem reduction).
// 4 threads per Q4_0 block, K_PER_ITER=8, QUANT_K=32.

#define BLOCK_SIZE 128
#define NUM_ROWS 2
#define K_PER_ITER 8
#define QUANT_K 32

layout(local_size_x = BLOCK_SIZE) in;

struct block_q4_0 {
    float16_t d;
    uint8_t qs[16];
};
struct block_q4_0_p16 {
    float16_t d;
    uint16_t qs[8];
};

struct block_q8_1 {
    float16_t d;
    float16_t s;
    int32_t qs[8];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q4_0 data_a[]; };
layout(scalar, set = 0, binding = 1) readonly buffer AP16 { block_q4_0_p16 data_a_p16[]; };
layout(scalar, set = 0, binding = 2) readonly buffer B { block_q8_1 data_b[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

shared float tmpsh[NUM_ROWS][BLOCK_SIZE / 32];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    const uint ncols = uint(cols);
    const uint nrows = uint(rows);
    const uint bpr = ncols >> 5;
    const uint b_qs_idx = tid & 3u;

    uint num_rows;
    if (first_row + NUM_ROWS <= nrows)
        num_rows = NUM_ROWS;
    else if (first_row < nrows)
        num_rows = nrows - first_row;
    else
        return;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) temp[n] = 0.0;

    const uint STRIDE = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = ncols / STRIDE;
    if (num_iters * STRIDE + K_PER_ITER * tid < ncols) num_iters++;

    uint unrolled = num_iters & ~3u;
    uint i = 0;

    while (i < unrolled) {
        [[unroll]] for (uint k = 0; k < 4u; k++) {
            const uint col = i * STRIDE + K_PER_ITER * tid;
            const uint b_ib = col >> 5;

            vec2 dsb = vec2(float(data_b[b_ib].d), float(data_b[b_ib].s));
            int32_t b_qs0 = data_b[b_ib].qs[b_qs_idx];
            int32_t b_qs1 = data_b[b_ib].qs[b_qs_idx + 4];

            uint ibi = first_row * ncols;
            [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) {
                const uint a_ib = (ibi + col) / QUANT_K;
                ibi += ncols;

                float da = float(data_a[a_ib].d);
                uint vui = uint(data_a_p16[a_ib].qs[b_qs_idx * 2])
                         | (uint(data_a_p16[a_ib].qs[b_qs_idx * 2 + 1]) << 16);
                int32_t a_lo = int32_t(vui & 0x0F0F0F0Fu);
                int32_t a_hi = int32_t((vui >> 4) & 0x0F0F0F0Fu);

                int32_t q_sum = dotPacked4x8EXT(a_lo, b_qs0) + dotPacked4x8EXT(a_hi, b_qs1);
                temp[n] += da * (float(q_sum) * dsb.x - 2.0 * dsb.y);
            }
            i++;
        }
    }

    while (i < num_iters) {
        const uint col = i * STRIDE + K_PER_ITER * tid;
        const uint b_ib = col >> 5;

        vec2 dsb = vec2(float(data_b[b_ib].d), float(data_b[b_ib].s));
        int32_t b_qs0 = data_b[b_ib].qs[b_qs_idx];
        int32_t b_qs1 = data_b[b_ib].qs[b_qs_idx + 4];

        uint ibi = first_row * ncols;
        [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) {
            const uint a_ib = (ibi + col) / QUANT_K;
            ibi += ncols;

            float da = float(data_a[a_ib].d);
            uint vui = uint(data_a_p16[a_ib].qs[b_qs_idx * 2])
                     | (uint(data_a_p16[a_ib].qs[b_qs_idx * 2 + 1]) << 16);
            int32_t a_lo = int32_t(vui & 0x0F0F0F0Fu);
            int32_t a_hi = int32_t((vui >> 4) & 0x0F0F0F0Fu);

            int32_t q_sum = dotPacked4x8EXT(a_lo, b_qs0) + dotPacked4x8EXT(a_hi, b_qs1);
            temp[n] += da * (float(q_sum) * dsb.x - 2.0 * dsb.y);
        }
        i++;
    }

    [[unroll]] for (uint n = 0; n < NUM_ROWS; n++)
        temp[n] = subgroupAdd(temp[n]);

    if (gl_SubgroupInvocationID == 0) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; n++)
            tmpsh[n][gl_SubgroupID] = temp[n];
    }
    barrier();

    if (tid == 0) {
        [[unroll]] for (uint n = 0; n < num_rows; n++) {
            float sum = 0.0;
            [[unroll]] for (uint s = 0; s < BLOCK_SIZE / 32; s++)
                sum += tmpsh[n][s];
            out_data[first_row + n] = sum;
        }
    }
}
