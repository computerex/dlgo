#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 32) in;

struct block_q5_k {
    float16_t d;
    float16_t dmin;
    uint8_t scales[12];
    uint8_t qh[32];
    uint8_t qs[128];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer Weights { block_q5_k blocks[]; };
layout(set = 0, binding = 2) readonly buffer X { float x_data[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

shared float partial[32];

uint byte_at(uint x, int idx) {
    return (x >> (idx * 8)) & 0xFFu;
}

int unpack_scale(uint i0, uint i1, uint t, int idx) {
    if (idx < 4) {
        uint b = byte_at(i0, idx);
        uint tb = byte_at(t, idx);
        return int((b & 0x3Fu) | ((tb & 0x03u) << 4));
    }
    int j = idx - 4;
    uint b = byte_at(i1, j);
    uint tb = byte_at(t, j);
    return int((b & 0x3Fu) | (((tb >> 4) & 0x03u) << 4));
}

int unpack_min(uint i0, uint i1, uint t, int idx) {
    if (idx < 4) {
        uint b = byte_at(i0, idx);
        uint tb = byte_at(t, idx);
        return int((b & 0x3Fu) | (((tb >> 2) & 0x03u) << 4));
    }
    int j = idx - 4;
    uint b = byte_at(i1, j);
    uint tb = byte_at(t, j);
    return int((b & 0x3Fu) | (((tb >> 6) & 0x03u) << 4));
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= uint(rows)) return;

    int bpr = cols >> 8;
    uint pos_id = gl_WorkGroupID.y;
    uint pos_x_off = pos_id * uint(cols);
    float acc = 0.0;

    for (int b = 0; b < bpr; b++) {
        uint bi = row * uint(bpr) + uint(b);
        float d = float(blocks[bi].d);
        float dmin = float(blocks[bi].dmin);

        uint i0 = uint(blocks[bi].scales[0]) | (uint(blocks[bi].scales[1]) << 8) |
            (uint(blocks[bi].scales[2]) << 16) | (uint(blocks[bi].scales[3]) << 24);
        uint i1 = uint(blocks[bi].scales[4]) | (uint(blocks[bi].scales[5]) << 8) |
            (uint(blocks[bi].scales[6]) << 16) | (uint(blocks[bi].scales[7]) << 24);
        uint t = uint(blocks[bi].scales[8]) | (uint(blocks[bi].scales[9]) << 8) |
            (uint(blocks[bi].scales[10]) << 16) | (uint(blocks[bi].scales[11]) << 24);

        uint u1 = 1u;
        uint u2 = 2u;
        int x_base = b * 256;

        for (int grp = 0; grp < 4; grp++) {
            float sc1 = d * float(unpack_scale(i0, i1, t, grp * 2));
            float mn1 = dmin * float(unpack_min(i0, i1, t, grp * 2));
            float sc2 = d * float(unpack_scale(i0, i1, t, grp * 2 + 1));
            float mn2 = dmin * float(unpack_min(i0, i1, t, grp * 2 + 1));

            uint qbyte = uint(blocks[bi].qs[grp * 32 + int(lane)]);
            uint qh = uint(blocks[bi].qh[int(lane)]);

            int q1 = int(qbyte & 0x0Fu);
            if ((qh & u1) != 0u) {
                q1 |= 16;
            }
            int q2 = int((qbyte >> 4) & 0x0Fu);
            if ((qh & u2) != 0u) {
                q2 |= 16;
            }

            uint x1_idx = int(pos_x_off) + x_base + grp * 64 + int(lane);
            uint x2_idx = x1_idx + 32u;
            acc += (float(q1) * sc1 - mn1) * x_data[x1_idx];
            acc += (float(q2) * sc2 - mn2) * x_data[x2_idx];

            u1 <<= 2;
            u2 <<= 2;
        }
    }

    partial[lane] = acc;
    barrier();

    for (uint s = 16u; s > 0u; s >>= 1u) {
        if (lane < s) {
            partial[lane] += partial[lane + s];
        }
        barrier();
    }

    if (lane == 0u) {
        out_data[pos_id * uint(rows) + row] = partial[0];
    }
}
