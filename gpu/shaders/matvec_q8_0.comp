#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_control_flow_attributes : enable

// Ported from llama.cpp mul_mat_vec.comp for Q8_0.
// All 128 threads cooperate on NUM_ROWS=2 rows (hybrid subgroup+shmem reduction).
// K_PER_ITER=8, QUANT_K=32, QUANT_R=1.

#define BLOCK_SIZE 128
#define NUM_ROWS 2
#define K_PER_ITER 8
#define QUANT_K 32

layout(local_size_x = BLOCK_SIZE) in;

struct block_q8_0 {
    float16_t d;
    int8_t qs[32];
};

layout(set = 0, binding = 0) buffer Out { float out_data[]; };
layout(scalar, set = 0, binding = 1) readonly buffer A { block_q8_0 data_a[]; };
layout(set = 0, binding = 2) readonly buffer B { vec4 data_b_v4[]; };

layout(push_constant) uniform Params {
    int rows;
    int cols;
};

shared float tmpsh[NUM_ROWS][BLOCK_SIZE / 32];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
    const uint ncols = uint(cols);
    const uint nrows = uint(rows);

    uint num_rows;
    if (first_row + NUM_ROWS <= nrows)
        num_rows = NUM_ROWS;
    else if (first_row < nrows)
        num_rows = nrows - first_row;
    else
        return;

    const uint pos_id = gl_WorkGroupID.y;
    const uint b_off = pos_id * (ncols >> 2);
    const uint d_off = pos_id * nrows;

    float temp[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) temp[n] = 0.0;

    const uint STRIDE = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = ncols / STRIDE;
    if (num_iters * STRIDE + K_PER_ITER * tid < ncols) num_iters++;

    uint unrolled = num_iters & ~3u;
    uint i = 0;

    while (i < unrolled) {
        [[unroll]] for (uint k = 0; k < 4u; k++) {
            const uint col = i * STRIDE + K_PER_ITER * tid;
            const uint iqs = col % QUANT_K;

            const vec4 bv0 = data_b_v4[b_off + col / 4];
            const vec4 bv1 = data_b_v4[b_off + col / 4 + 1u];

            uint ibi = first_row * ncols;
            [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) {
                const uint ib = (ibi + col) / QUANT_K;
                ibi += ncols;

                vec4 v0 = vec4(float(data_a[ib].qs[iqs]),   float(data_a[ib].qs[iqs+1u]),
                               float(data_a[ib].qs[iqs+2u]), float(data_a[ib].qs[iqs+3u]));
                vec4 v1 = vec4(float(data_a[ib].qs[iqs+4u]), float(data_a[ib].qs[iqs+5u]),
                               float(data_a[ib].qs[iqs+6u]), float(data_a[ib].qs[iqs+7u]));

                temp[n] += float(data_a[ib].d) * (dot(bv0, v0) + dot(bv1, v1));
            }
            i++;
        }
    }

    while (i < num_iters) {
        const uint col = i * STRIDE + K_PER_ITER * tid;
        const uint iqs = col % QUANT_K;

        const vec4 bv0 = data_b_v4[b_off + col / 4];
        const vec4 bv1 = data_b_v4[b_off + col / 4 + 1u];

        uint ibi = first_row * ncols;
        [[unroll]] for (uint n = 0; n < NUM_ROWS; n++) {
            const uint ib = (ibi + col) / QUANT_K;
            ibi += ncols;

            vec4 v0 = vec4(float(data_a[ib].qs[iqs]),   float(data_a[ib].qs[iqs+1u]),
                           float(data_a[ib].qs[iqs+2u]), float(data_a[ib].qs[iqs+3u]));
            vec4 v1 = vec4(float(data_a[ib].qs[iqs+4u]), float(data_a[ib].qs[iqs+5u]),
                           float(data_a[ib].qs[iqs+6u]), float(data_a[ib].qs[iqs+7u]));

            temp[n] += float(data_a[ib].d) * (dot(bv0, v0) + dot(bv1, v1));
        }
        i++;
    }

    [[unroll]] for (uint n = 0; n < NUM_ROWS; n++)
        temp[n] = subgroupAdd(temp[n]);

    if (gl_SubgroupInvocationID == 0) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; n++)
            tmpsh[n][gl_SubgroupID] = temp[n];
    }
    barrier();

    if (tid == 0) {
        [[unroll]] for (uint n = 0; n < num_rows; n++) {
            float sum = 0.0;
            [[unroll]] for (uint s = 0; s < BLOCK_SIZE / 32; s++)
                sum += tmpsh[n][s];
            out_data[d_off + first_row + n] = sum;
        }
    }
}
