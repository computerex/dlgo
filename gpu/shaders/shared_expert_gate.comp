#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Fused shared expert gate: dot(gate_w, input) -> sigmoid -> scale output
// Single workgroup processes the entire dot product and scales the output.
//
// Buffers:
//   0: out_data (read/write, float[n]) - output vector to scale in-place
//   1: gate_w   (read, float[n])       - gate weight vector
//   2: input    (read, float[n])       - input vector (ffn_norm)
//
// Push constants:
//   n: vector dimension

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Out     { float out_data[]; };
layout(set = 0, binding = 1) readonly buffer GateW { float gate_w[];  };
layout(set = 0, binding = 2) readonly buffer Input { float input_data[]; };

layout(push_constant) uniform Params { int n; };

shared float s_gate;
shared float s_partial[32];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_size = gl_WorkGroupSize.x;

    // Each thread accumulates its portion of the dot product
    float partial = 0.0;
    for (uint i = tid; i < n; i += wg_size) {
        partial += gate_w[i] * input_data[i];
    }

    // Subgroup reduction
    partial = subgroupAdd(partial);

    // Cross-subgroup reduction via shared memory
    uint sg_id = gl_SubgroupID;
    uint sg_count = gl_NumSubgroups;

    if (gl_SubgroupInvocationID == 0) {
        s_partial[sg_id] = partial;
    }
    barrier();

    // First subgroup reduces across subgroups
    if (sg_id == 0) {
        float val = (gl_SubgroupInvocationID < sg_count) ? s_partial[gl_SubgroupInvocationID] : 0.0;
        val = subgroupAdd(val);
        if (gl_SubgroupInvocationID == 0) {
            // sigmoid(dot)
            s_gate = 1.0 / (1.0 + exp(-val));
        }
    }
    barrier();

    // Scale output by the sigmoid gate
    float gate = s_gate;
    for (uint i = tid; i < n; i += wg_size) {
        out_data[i] *= gate;
    }
}
