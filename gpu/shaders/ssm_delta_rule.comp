#version 450

// SSM Delta Rule (fused, legacy — kept for backwards compat).
// The decomposed path (ssm_decay/predict/update/output) is preferred.

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) buffer State { float state_data[]; };
layout(set = 0, binding = 1) buffer QKV { float qkv[]; };
layout(set = 0, binding = 2) buffer Alpha { float alpha_data[]; };
layout(set = 0, binding = 3) buffer Beta { float beta_data[]; };
layout(set = 0, binding = 4) buffer Y { float y_data[]; };

layout(push_constant) uniform Params {
    int num_heads;
    int head_k_dim;
    int head_v_dim;
    int key_dim;
};

void main() {
    uint h = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;

    if (h >= num_heads || j >= head_v_dim) return;

    float decay = alpha_data[h];
    float lr = beta_data[h];

    int num_kv_groups = key_dim / head_k_dim;
    uint kvGroup = h % uint(num_kv_groups);

    uint sOff = h * uint(head_k_dim) * uint(head_v_dim);
    uint qOff = kvGroup * uint(head_k_dim);
    uint kOff = uint(key_dim) + kvGroup * uint(head_k_dim);
    uint vOff = 2u * uint(key_dim) + h * uint(head_v_dim);

    precise float col[128];
    for (int i = 0; i < head_k_dim; i++) {
        col[i] = state_data[sOff + uint(i) * uint(head_v_dim) + j] * decay;
    }

    precise float pred = 0.0;
    for (int i = 0; i < head_k_dim; i++) {
        precise float product = col[i] * qkv[kOff + uint(i)];
        pred += product;
    }

    precise float delta = lr * (qkv[vOff + j] - pred);

    for (int i = 0; i < head_k_dim; i++) {
        precise float product = qkv[kOff + uint(i)] * delta;
        col[i] += product;
    }

    for (int i = 0; i < head_k_dim; i++) {
        state_data[sOff + uint(i) * uint(head_v_dim) + j] = col[i];
    }

    precise float dot = 0.0;
    for (int i = 0; i < head_k_dim; i++) {
        precise float product = col[i] * qkv[qOff + uint(i)];
        dot += product;
    }
    y_data[h * uint(head_v_dim) + j] = dot;
}
