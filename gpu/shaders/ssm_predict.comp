#version 450

// SSM Step 2: Predict — compute pred[h][j] = sum_i(state[h][i][j] * k[i])
// One workgroup per head, local_size_x threads handle columns.
// Writes prediction to scratch buffer.

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) buffer State { float state_data[]; };
layout(set = 0, binding = 1) buffer QKV { float qkv[]; };
layout(set = 0, binding = 2) buffer Pred { float pred_data[]; };

layout(push_constant) uniform Params {
    int num_heads;
    int head_k_dim;
    int head_v_dim;
    int key_dim;
};

void main() {
    uint h = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;
    if (h >= num_heads || j >= head_v_dim) return;

    int num_kv_groups = key_dim / head_k_dim;
    uint kvGroup = h % uint(num_kv_groups);
    uint sOff = h * uint(head_k_dim) * uint(head_v_dim);
    uint kOff = uint(key_dim) + kvGroup * uint(head_k_dim);

        precise float pred = 0.0;
        precise float comp = 0.0;
        for (int i = 0; i < head_k_dim; i++) {
            precise float p = state_data[sOff + uint(i) * uint(head_v_dim) + j] * qkv[kOff + uint(i)];
            precise float y = p - comp;
            precise float t = pred + y;
            comp = (t - pred) - y;
            pred = t;
        }
        pred_data[h * uint(head_v_dim) + j] = pred;
}
