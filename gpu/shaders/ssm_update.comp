#version 450

// SSM Step 3: Update state with error correction.
// delta[j] = beta[h] * (v[j] - pred[h][j])
// state[h][i][j] += k[i] * delta[j]
// One workgroup per head, local_size_x threads handle columns.

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) buffer State { float state_data[]; };
layout(set = 0, binding = 1) buffer QKV { float qkv[]; };
layout(set = 0, binding = 2) buffer Beta { float beta_data[]; };
layout(set = 0, binding = 3) buffer Pred { float pred_data[]; };

layout(push_constant) uniform Params {
    int num_heads;
    int head_k_dim;
    int head_v_dim;
    int key_dim;
};

void main() {
    uint h = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;
    if (h >= num_heads || j >= head_v_dim) return;

    float lr = beta_data[h];
    int num_kv_groups = key_dim / head_k_dim;
    uint kvGroup = h % uint(num_kv_groups);
    uint sOff = h * uint(head_k_dim) * uint(head_v_dim);
    uint kOff = uint(key_dim) + kvGroup * uint(head_k_dim);
    uint vOff = 2u * uint(key_dim) + h * uint(head_v_dim);

    precise float pred = pred_data[h * uint(head_v_dim) + j];
    precise float delta = lr * (qkv[vOff + j] - pred);

    for (int i = 0; i < head_k_dim; i++) {
        uint idx = sOff + uint(i) * uint(head_v_dim) + j;
        precise float s = state_data[idx];
        precise float p = qkv[kOff + uint(i)] * delta;
        state_data[idx] = s + p;
    }
}
